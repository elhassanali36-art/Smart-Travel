NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://smarttravel:smarttravel@localhost:5432/smarttravel?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=smart-travel-api
JWT_AUDIENCE=smart-travel-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
SEED_DEMO_PASSWORD=replace-with-a-random-16-plus-character-development-password
# Optional: number of reverse-proxy hops to trust for client IPs (rate limiting). Leave unset when not behind a proxy.
# TRUST_PROXY=1
# Refresh-token cookie. SameSite: lax (default) | strict | none. "none" needs HTTPS and is only for a web app on a different site than the API.
# COOKIE_SAMESITE=lax
